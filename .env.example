# ============================================================
# China Deep Travel — Environment Variables (copy to .env.local)
# ============================================================

# ---- Database (PostgreSQL) ----
# Local docker: postgresql://cpt_user:cpt_pass@localhost:5432/cpt_db
# Supabase:     postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
# Neon:         postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://cpt_user:cpt_pass@localhost:5432/cpt_db"

# ---- Auth / JWT ----
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"

# ---- Stripe (Payments) ----
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# ---- Email (Resend) ----
RESEND_API_KEY="re_xxx"
EMAIL_FROM="China Deep Travel <hello@chinadeeptravel.com>"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="China Deep Travel"
NEXT_PUBLIC_CONTACT_EMAIL="hello@chinadeeptravel.com"

# ---- File Storage (Cloudflare R2 / S3) — optional for v1 ----
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# NEXT_PUBLIC_CDN_URL="https://cdn.chinadeeptravel.com"
